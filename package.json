{
  "name": "yi-lunar",
  "version": "0.1.0",
  "description": "易历 —— 阴历/农历相关 JS 工具库（脚手架）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "miniprogram": "yi-lunar",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "yi-lunar"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "postbuild": "node -e \"require('fs').copyFileSync('yi-lunar/index.d.cts','yi-lunar/index.d.ts')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "lunar",
    "calendar",
    "library"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rolldown/binding-darwin-arm64": "1.2.13",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "lunar-typescript": "^1.8.6"
  }
}
