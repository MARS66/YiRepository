<!--components/yi-detail/yi-detail.wxml-->
<view class="yd-card">
  <view class="yd-head">
    <text class="yd-title">{{title}}</text>
    <text class="yd-link">术语说明</text>
  </view>
  <view class="yd-grid">
    <view class="yd-item" wx:for="{{items}}" wx:key="cn" bindtap="onTapItem" data-item="{{item}}">
      <view class="yd-left">
        <text class="yd-yi">{{item.yi}}</text>
        <text class="yd-label">{{item.cn}}</text>
      </view>
      <view class="yd-val">
        <view class="yd-yi">{{item.valueYi}}</view>
        <view class="yd-label">{{item.valueCn}}</view>
      </view>
    </view>
  </view>
</view>
