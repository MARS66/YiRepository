<!--components/audio-btn/audio-btn.wxml-->
<view class="audio-btn {{playing ? 'playing' : ''}} {{color === 'gold' ? 'gold' : ''}}" hover-class="audio-btn-hover" bindtap="toggleAudio">
  <text class="icon icon-play">♫</text>
  <view class="icon icon-pause">
    <view class="pause-bar"></view>
    <view class="pause-bar"></view>
  </view>
</view>
