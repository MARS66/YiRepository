<!--components/daily-fortune/daily-fortune.wxml-->
<view class="df-card" wx:if="{{fortune.taboo && fortune.taboo.length}}" bindtap="onTap">
   <image class="fortune-seal" src="/static/fortune-seal.png" mode="aspectFit" aria-hidden="{{true}}" />
  <view>
    <text class="df-title"> <text>{{fortune.taboo[0]}}</text> , {{fortune.taboo[1]}}</text>
    <text class="df-desc">{{fortune.tabooFull}}</text>
  </view>
</view>
