<!--pages/zeri/result/result.wxml-->
<page-meta background-color="{{isDark ? '#181713' : '#f8f4eb'}}" page-style="background-color: {{isDark ? '#181713' : '#f8f4eb'}};" />
<layout title="{{eventLabel}}" eyebrow="YI LIFE · ZERI" bind:themechange="onThemeChange">

  <!-- 日历 -->
  <view class="calendar-card">
    <calendar
      areas="{{calendarAreas}}"
      marks="{{marks}}"
      weekstart="{{1}}"
      alignDate="baseline"
      darkmode="{{isDark}}"
      style="{{calendarStyle}}"
      bindload="onCalendarLoad"
      bindclick="onCalendarClick"
      bindchange="onCalendarChange"
    />
  </view>

  <!-- 当日吉凶 -->
  <view class="fortune-card">
    <view class="fortune-head">
      <text class="fortune-date">{{selectedLabel}}</text>
      <text class="level-badge {{levelClass}}">{{level}}</text>
    </view>
    <text class="lunar-yi">{{lunarText}}</text>
    <text class="lunar-cn">{{lunarCn}}</text>
    <view class="reason-list">
      <view class="reason-item" wx:for="{{reasons}}" wx:key="*this">
        <text class="reason-dot">·</text>
        <text class="reason-text">{{item}}</text>
      </view>
    </view>
  </view>
  <text class="page-foot">结果仅供文化参考 · YI LIFE</text>
</layout>
