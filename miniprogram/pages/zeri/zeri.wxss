@charset "UTF-8";
/* pages/zeri/zeri.scss */
@keyframes sheet-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
@keyframes mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
/* 功能说明 */
.intro {
  position: relative;
  overflow: hidden;
  padding: 28rpx 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #79211c, #a8452f);
  box-shadow: 0 14rpx 32rpx rgba(156, 45, 37, 0.24);
  color: #fffdf7;
}
.intro .intro-glow {
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(243, 217, 164, 0.34), transparent 68%);
}
.intro .intro-eyebrow {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #f3d9a4;
}
.intro .intro-title {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1.45;
}
.intro .intro-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 253, 247, 0.82);
}

/* 人员信息 */
.person-card {
  margin-top: 20rpx;
  padding: 4rpx 28rpx;
  border-radius: 32rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  box-shadow: var(--shadow);
}

.person-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.person-row:last-child {
  border-bottom: none;
}
.person-row .person-avatar {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--accent);
  background: var(--soft);
  border: 2rpx solid var(--line);
}
.person-row .person-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.person-row .person-main .person-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--coal);
}
.person-row .person-main .person-meta {
  font-size: 22rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.person-row .person-main .person-meta.pending {
  color: var(--gold);
}
.person-row .person-action {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 198rpx;
  font-size: 22rpx;
  color: var(--fire);
  background: var(--soft);
  border: 2rpx solid var(--line);
}

/* 测算按钮 */
.calc-btn {
  height: 92rpx;
  margin-top: 24rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 1;
  color: #fffdf7;
  background: linear-gradient(135deg, #79211c, #b74d36);
  box-shadow: 0 10rpx 24rpx rgba(156, 45, 37, 0.26);
}
.calc-btn.disabled {
  opacity: 0.45;
  box-shadow: none;
}

.page-tip {
  display: block;
  margin-top: 22rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--muted);
  text-align: center;
}

.page-foot {
  display: block;
  padding: 14rpx 0 40rpx;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--muted);
  opacity: 0.7;
}

/* 人员信息弹层 */
.editor-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 16, 12, 0.5);
  animation: mask-in 0.2s ease both;
}

.editor-sheet {
  width: 100%;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  border-radius: 40rpx 40rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.18);
  animation: sheet-up 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.editor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 2rpx solid var(--line);
}
.editor-head .editor-titles {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.editor-head .editor-titles .editor-eyebrow {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: var(--gold);
}
.editor-head .editor-titles .editor-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--coal);
}
.editor-head .editor-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--muted);
  background: var(--soft);
}

.editor-body {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
  padding: 8rpx 32rpx 0;
  box-sizing: border-box;
}

.field {
  padding: 24rpx 0 26rpx;
  border-bottom: 2rpx solid var(--line);
}
.field:last-child {
  border-bottom: 0;
}
.field .field-label {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--coal);
}
.field .field-label .field-sub {
  font-size: 20rpx;
  font-weight: normal;
  color: var(--muted);
}
.field .field-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--muted);
}

/* 常用人员快捷选择 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}
.quick-grid .quick-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 10rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: var(--soft);
  min-width: 0;
  transition: all 0.2s ease;
}
.quick-grid .quick-chip .quick-name {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--coal);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quick-grid .quick-chip.active {
  border-color: var(--fire);
  background: var(--paper);
  box-shadow: 0 6rpx 18rpx rgba(156, 45, 37, 0.16);
}
.quick-grid .quick-chip.active .quick-name {
  color: var(--fire);
}

/* 属相 */
.zodiac-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}
.zodiac-grid .zodiac-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 10rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--line);
  background: var(--soft);
  transition: all 0.2s ease;
}
.zodiac-grid .zodiac-chip .zc-yi {
  font-size: 30rpx;
  color: var(--muted);
}
.zodiac-grid .zodiac-chip .zc-cn {
  font-size: 20rpx;
  color: var(--coal);
}
.zodiac-grid .zodiac-chip.active {
  border-color: var(--fire);
  background: var(--paper);
  box-shadow: 0 6rpx 18rpx rgba(156, 45, 37, 0.16);
}
.zodiac-grid .zodiac-chip.active .zc-yi {
  color: var(--fire);
}
.zodiac-grid .zodiac-chip.active .zc-cn {
  color: var(--fire);
  font-weight: bold;
}

/* 岁数 */
.age-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}
.age-grid .age-chip {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
  padding: 16rpx 10rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--line);
  background: var(--soft);
}
.age-grid .age-chip .age-num {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--coal);
}
.age-grid .age-chip .age-unit {
  font-size: 18rpx;
  color: var(--muted);
}
.age-grid .age-chip.active {
  border-color: var(--fire);
  background: var(--fire);
}
.age-grid .age-chip.active .age-num,
.age-grid .age-chip.active .age-unit {
  color: #fffdf7;
}

/* 性别 */
.gender-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
  margin-top: 18rpx;
}
.gender-grid .gender-chip {
  padding: 16rpx 10rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--coal);
  background: var(--soft);
  border: 2rpx solid var(--line);
  transition: all 0.2s ease;
}
.gender-grid .gender-chip.active {
  color: var(--fire);
  font-weight: bold;
  background: var(--paper);
  border-color: var(--fire);
  box-shadow: 0 6rpx 18rpx rgba(156, 45, 37, 0.16);
}

.editor-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx 24rpx;
  border-top: 2rpx solid var(--line);
  background: var(--paper);
}
.editor-actions .editor-btn {
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
  margin: 0;
}
.editor-actions .editor-btn::after {
  border: none;
}
.editor-actions .editor-btn.ghost {
  width: 170rpx;
  flex-shrink: 0;
  background: var(--soft);
  color: var(--coal);
  border: 2rpx solid var(--line);
}
.editor-actions .editor-btn.primary {
  flex: 1;
  background: linear-gradient(135deg, #79211c, #b74d36);
  color: #fffdf7;
  box-shadow: 0 8rpx 20rpx rgba(156, 45, 37, 0.24);
}
.editor-actions .editor-btn.primary.disabled {
  opacity: 0.45;
  box-shadow: none;
}
