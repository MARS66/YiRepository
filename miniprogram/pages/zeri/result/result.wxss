@charset "UTF-8";
/* pages/zeri/result/result.scss */
/* 测算信息 */
.summary {
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  box-shadow: var(--shadow);
}
.summary .summary-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.summary .summary-main .chip {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 198rpx;
  font-size: 22rpx;
  font-weight: bold;
}
.summary .summary-main .chip.gold {
  color: var(--gold);
  background: rgba(170, 123, 45, 0.1019607843);
  border: 2rpx solid rgba(170, 123, 45, 0.2509803922);
}
.summary .summary-main .summary-person {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--coal);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.summary .summary-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--muted);
}

/* 日历 */
.calendar-card {
  margin-top: 20rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(45, 28, 15, 0.045);
}

/* 当日吉凶 */
.fortune-card {
  margin-top: 20rpx;
  padding: 28rpx 30rpx;
  border-radius: 36rpx;
  border: 2rpx solid var(--accent-border);
  background: linear-gradient(135deg, rgba(156, 45, 37, 0.14) 0%, rgba(170, 123, 45, 0.18) 100%);
  box-shadow: 0 10rpx 30rpx rgba(45, 28, 15, 0.045);
}
.fortune-card .fortune-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.fortune-card .fortune-head .fortune-date {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--coal);
}
.fortune-card .fortune-head .level-badge {
  flex-shrink: 0;
  min-width: 96rpx;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.fortune-card .fortune-head .level-badge.good {
  color: var(--green);
  background: var(--good-bg);
  border: 2rpx solid rgba(66, 117, 83, 0.4);
}
.fortune-card .fortune-head .level-badge.plain {
  color: var(--muted);
  background: var(--soft);
  border: 2rpx solid var(--line);
}
.fortune-card .fortune-head .level-badge.bad {
  color: #b74d36;
  background: #f6e7e1;
  border: 2rpx solid rgba(183, 77, 54, 0.4);
}
.fortune-card .fortune-head .level-badge.avoid {
  color: #fffdf7;
  background: var(--fire);
  border: 2rpx solid var(--fire);
}
.fortune-card .lunar-yi {
  display: block;
  margin-top: 22rpx;
  font-size: 38rpx;
  font-weight: bold;
  letter-spacing: 3rpx;
  color: var(--coal);
}
.fortune-card .lunar-cn {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  letter-spacing: 3rpx;
  color: var(--muted);
}
.fortune-card .reason-list {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(112, 105, 94, 0.28);
}
.fortune-card .reason-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}
.fortune-card .reason-item + .reason-item {
  margin-top: 12rpx;
}
.fortune-card .reason-item .reason-dot {
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--gold);
}
.fortune-card .reason-item .reason-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--coal);
}

/* 当日彝历 */
.card {
  margin-top: 20rpx;
  padding: 28rpx 30rpx;
  border-radius: 36rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  box-shadow: var(--shadow);
}
.card .sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card .sec-head .section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--coal);
}
.card .term-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}
.card .term-grid .term-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: var(--soft);
  border: 2rpx solid var(--line);
}
.card .term-grid .term-item .term-key {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.card .term-grid .term-item .term-key .key-yi {
  font-size: 26rpx;
  color: var(--gold);
}
.card .term-grid .term-item .term-key .key-cn {
  font-size: 20rpx;
  color: var(--muted);
}
.card .term-grid .term-item .term-val {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
}
.card .term-grid .term-item .term-val .val-yi {
  font-size: 34rpx;
  color: var(--coal);
}
.card .term-grid .term-item .term-val .val-cn {
  font-size: 22rpx;
  color: var(--coal);
}

.page-foot {
  display: block;
  padding: 26rpx 0 40rpx;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--muted);
  opacity: 0.7;
}
