<!--pages/date-navigation/date-navigation.wxml-->
<layout title="彝历查询" eyebrow="YI ALIVE ASSISTANT">

  <!-- 日期导航工具栏 -->
  <view class="card toolbar">
    <view class="toolbar-main">
      <view class="nav-btn" hover-class="nav-btn-hover" bindtap="prevDay">‹</view>
      <picker class="date-picker" mode="date" value="{{solarDate}}" start="1900-01-01" end="2100-12-31" bindchange="onDateChange">
        <view class="date-block">
          <view class="date-main">{{yearText}}年{{monthText}}月{{dateText}}日</view>
          <view class="date-sub">{{lunarText}} · 星期{{weekday}}<text class="pick-hint"> 点选 ▾</text></view>
        </view>
      </picker>
      <view class="nav-btn" hover-class="nav-btn-hover" bindtap="nextDay">›</view>
    </view>
  </view>

  <!-- 彝历罗盘 -->
  <view class="card compass-card">
    <view class="compass">
      <view class="ring outer"></view>
      <view class="ring inner"></view>
      <view class="spoke" style="transform: rotate(0deg);"></view>
      <view class="spoke" style="transform: rotate(60deg);"></view>
      <view class="spoke" style="transform: rotate(120deg);"></view>

      <view class="compass-center">
        <text class="center-year">{{yiDate.year[0]}}ꈎ · {{yiDate.month[0]}}ꆪ</text>
        <text class="center-day">{{yiDate.day[0]}}ꑍ · {{yiDate.dayMoon[0]}}ꑍ</text>
        <text class="center-cn">{{yiDate.year[1]}}年·{{yiDate.month[1]}}月·{{yiDate.day[1]}}日·{{yiDate.dayMoon[1]}}日</text>
      </view>

      <!-- 塔博惹 -->
      <view class="compass-name" style="transform: rotate(0deg) translateY(-185rpx) rotate(0deg);">
        <text class="name-yi">ꄤꁨꌺ</text>
        <text class="name-cn">塔博惹</text>
      </view>
      <view class="compass-value" style="transform: rotate(0deg) translateY(-270rpx) rotate(0deg);">
        <text class="value-yi">{{yiDate.tabooSon[0]}}</text>
        <text class="value-cn">{{yiDate.tabooSon[1]}}</text>
      </view>
      <!-- 库觉 -->
      <view class="compass-name" style="transform: rotate(60deg) translateY(-185rpx) rotate(-60deg);">
        <text class="name-yi">ꈐꐡ</text>
        <text class="name-cn">库觉</text>
      </view>
      <view class="compass-value" style="transform: rotate(60deg) translateY(-270rpx) rotate(-60deg);">
        <text class="value-yi">{{kuJior[0]}}</text>
        <text class="value-cn">{{kuJior[1]}}</text>
      </view>
      <!-- 狼色 -->
      <view class="compass-name" style="transform: rotate(120deg) translateY(-185rpx) rotate(-120deg);">
        <text class="name-yi">ꆿꌋ</text>
        <text class="name-cn">狼色</text>
      </view>
      <view class="compass-value" style="transform: rotate(120deg) translateY(-270rpx) rotate(-120deg);">
        <text class="value-yi">{{laSe[0]}}</text>
        <text class="value-cn">{{laSe[1]}}</text>
      </view>
      <!-- 木色则尼 -->
      <view class="compass-name" style="transform: rotate(180deg) translateY(-185rpx) rotate(-180deg);">
        <text class="name-yi">ꃅꌋꋠꑍ</text>
        <text class="name-cn">木色则尼</text>
      </view>
      <view class="compass-value" style="transform: rotate(180deg) translateY(-270rpx) rotate(-180deg);">
        <text class="value-yi">{{zeta[0]}}</text>
        <text class="value-cn">{{zeta[1]}}</text>
      </view>
      <!-- 母塔博 -->
      <view class="compass-name" style="transform: rotate(240deg) translateY(-185rpx) rotate(-240deg);">
        <text class="name-yi">ꄤꁨꀋꃀ</text>
        <text class="name-cn">母塔博</text>
      </view>
      <view class="compass-value" style="transform: rotate(240deg) translateY(-270rpx) rotate(-240deg);">
        <text class="value-yi">{{yiDate.tabooMon[0]}}</text>
        <text class="value-cn">{{yiDate.tabooMon[1]}}</text>
      </view>
      <!-- 公塔博 -->
      <view class="compass-name" style="transform: rotate(300deg) translateY(-185rpx) rotate(-300deg);">
        <text class="name-yi">ꄤꁨꀋꀮ</text>
        <text class="name-cn">公塔博</text>
      </view>
      <view class="compass-value" style="transform: rotate(300deg) translateY(-270rpx) rotate(-300deg);">
        <text class="value-yi">{{yiDate.tabooFat[0]}}</text>
        <text class="value-cn">{{yiDate.tabooFat[1]}}</text>
      </view>
    </view>

    <!-- 彝历宜忌 -->
    <view class="fortune-strip">
      <view class="fortune-label">
        <view>彝族</view>
        <view><text class="green">日</text><text class="fire">历</text></view>
      </view>
      <view class="fortune-body">
        <text class="fortune-main">{{yiDate.year[0]}}ꈎ·{{yiDate.month[0]}}ꆪ·{{yiDate.day[0]}}ꑍ·{{yiDate.dayMoon[0]}}ꑍ</text>
        <text class="fortune-desc">{{yiDate.year[1]}}年·{{yiDate.month[1]}}月·{{yiDate.day[1]}}日·{{yiDate.dayMoon[1]}}日</text>
      </view>
      <audio-btn date="{{solarDate}}" />
    </view>
  </view>

  <!-- 农历黄历 -->
  <view class="card lunar-card">
    <view class="section-head">
      <text class="section-title">农历黄历</text>
      <text class="section-link">{{lunarText}}</text>
    </view>
    <view class="lunar-grid">
      <view class="lunar-item">
        <text class="lunar-label">农历</text>
        <text class="lunar-val">{{lunarText}}</text>
      </view>
      <view class="lunar-item">
        <text class="lunar-label">月相</text>
        <text class="lunar-val">{{yueXiang}}</text>
      </view>
      <view class="lunar-item">
        <text class="lunar-label">年干支</text>
        <text class="lunar-val">{{yearGanZhi}} · {{shengXiao}}</text>
      </view>
      <view class="lunar-item">
        <text class="lunar-label">日干支</text>
        <text class="lunar-val">{{dayGanZhi}} · {{naYin}}</text>
      </view>
      <view class="lunar-item">
        <text class="lunar-label">值日</text>
        <text class="lunar-val">{{zhiXing}}日 · {{dayTianShen}}</text>
      </view>
      <view class="lunar-item">
        <text class="lunar-label">星宿</text>
        <text class="lunar-val">{{xiu}}宿 · {{xiuLuck}}</text>
      </view>
      <view class="lunar-item">
        <text class="lunar-label">节气</text>
        <text class="lunar-val">{{jieQi || '无'}}</text>
      </view>
      <view class="lunar-item">
        <text class="lunar-label">旬空</text>
        <text class="lunar-val">{{xunKong}}</text>
      </view>
    </view>
    <view class="lunar-rows">
      <view class="lunar-row">
        <text class="row-label">当日八字</text>
        <text class="row-val">{{baZi}}(当前时刻)</text>
      </view>
      <view class="lunar-row">
        <text class="row-label">彭祖百忌</text>
        <text class="row-val">{{pengZu}}</text>
      </view>
      <view class="lunar-row">
        <text class="row-label">冲煞</text>
        <text class="row-val">{{chongSha}}</text>
      </view>
      <view class="lunar-row">
        <text class="row-label">吉神宜趋</text>
        <text class="row-val">{{jiShen}}</text>
      </view>
      <view class="lunar-row">
        <text class="row-label">凶煞宜忌</text>
        <text class="row-val">{{xiongSha}}</text>
      </view>
    </view>
    <view class="pos-row">
      <view class="pos-item">
        <text class="pos-label">喜神</text>
        <text class="pos-val">{{posXi}}</text>
      </view>
      <view class="pos-item">
        <text class="pos-label">福神</text>
        <text class="pos-val">{{posFu}}</text>
      </view>
      <view class="pos-item">
        <text class="pos-label">财神</text>
        <text class="pos-val">{{posCai}}</text>
      </view>
      <view class="pos-item">
        <text class="pos-label">阳贵</text>
        <text class="pos-val">{{posYangGui}}</text>
      </view>
      <view class="pos-item">
        <text class="pos-label">阴贵</text>
        <text class="pos-val">{{posYinGui}}</text>
      </view>
    </view>
    <view class="yi-ji">
      <view class="yi-ji-block good">
        <text class="yi-ji-title">宜</text>
        <text class="yi-ji-content">{{lunarYi}}</text>
      </view>
      <view class="yi-ji-block bad">
        <text class="yi-ji-title">忌</text>
        <text class="yi-ji-content">{{lunarJi}}</text>
      </view>
    </view>
  </view>
</layout>
