<!--pages/assistant/assistant.wxml-->
<layout title="彝族生活助手" eyebrow="YI ALIVE ASSISTANT">
  <view class="search">
    <text class="search-icon">⌕</text>
    <input placeholder="搜索结婚、乔迁、翻译…" placeholder-class="search-placeholder" />
  </view>

  <view class="section-block">
    <view class="section-head">
      <text class="section-title">最近使用</text>
    </view>
    <view class="quick-grid col-3">
      <view class="quick-item">
        <text class="quick-icon">囍</text>
        <text class="quick-label">结婚吉日</text>
      </view>
      <view class="quick-item">
        <text class="quick-icon">迁</text>
        <text class="quick-label">乔迁吉日</text>
      </view>
      <view class="quick-item">
        <text class="quick-icon">译</text>
        <text class="quick-label">彝汉互译</text>
      </view>
    </view>
  </view>

  <view class="card tool-list">
    <view class="section-head">
      <text class="section-title">婚嫁助手</text>
      <text class="chip gold">热门</text>
    </view>
    <view class="tool-item" wx:for="{{marryTools}}" wx:key="label">
      <text class="tool-icon">{{item.icon}}</text>
      <view class="tool-info">
        <text class="tool-name">{{item.label}}</text>
        <text class="tool-desc">{{item.desc}}</text>
      </view>
      <text class="tool-arrow">›</text>
    </view>
  </view>

  <view class="section-block family-block">
    <view class="section-head">
      <text class="section-title">家庭与居家</text>
    </view>
    <view class="quick-grid">
      <view class="quick-item" wx:for="{{familyTools}}" wx:key="label">
        <text class="quick-icon">{{item.icon}}</text>
        <text class="quick-label">{{item.label}}</text>
      </view>
    </view>
  </view>
</layout>