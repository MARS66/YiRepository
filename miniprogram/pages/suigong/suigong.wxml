<!--pages/suigong/suigong.wxml-->
<layout title="喜得测算" eyebrow="SUIGONG · XIDE">

  <!-- 功能说明 -->
  <view class="intro">
    <view class="intro-glow"></view>
    <text class="intro-eyebrow">永恒命宫 · 今年命宫</text>
    <view class="intro-title">依母亲与本人岁数推算命宫方位</view>
    <view class="intro-desc">点击下方人员信息填写属相与岁数，完成后即可测算。</view>
  </view>

  <!-- 人员信息 -->
  <view class="person-card">
    <view class="person-row" hover-class="btn-hover" bindtap="openMother">
      <view class="person-avatar">母</view>
      <view class="person-main">
        <view class="person-name">母亲</view>
        <view class="person-meta {{motherMeta ? '' : 'pending'}}">{{motherMeta || '点击填写属相与岁数'}}</view>
      </view>
      <text class="person-action">编辑</text>
    </view>

    <view class="person-row" hover-class="btn-hover" bindtap="openPerson">
      <view class="person-avatar">我</view>
      <view class="person-main">
        <view class="person-name">测算人</view>
        <view class="person-meta {{personMeta ? '' : 'pending'}}">{{personMeta || '点击填写属相、岁数与性别'}}</view>
      </view>
      <text class="person-action">编辑</text>
    </view>
  </view>

  <!-- 测算入口 -->
  <button class="calc-btn {{canCalc ? '' : 'disabled'}}" hover-class="btn-hover" bindtap="calculate">开始测算</button>
  <text class="calc-hint" wx:if="{{!canCalc}}">需先填写母亲与测算人的属相、岁数及性别</text>

  <!-- 测算结果 -->
  <view class="result" wx:if="{{hasResult}}">
    <view class="result-head">
      <text class="result-eyebrow">RESULT</text>
      <text class="result-title">命宫方位</text>
    </view>

    <view class="result-board">
      <view class="result-cell">
        <text class="rc-label">今年命宫</text>
        <text class="rc-yi">{{yearYi}}</text>
        <text class="rc-cn">{{yearCn}}</text>
      </view>
      <view class="result-cell">
        <text class="rc-label">永恒命宫</text>
        <text class="rc-yi">{{eternalYi}}</text>
        <text class="rc-cn">{{eternalCn}}</text>
      </view>
    </view>
  </view>

  <text class="page-tip">岁数按当前农历年自动换算 · 结果仅供文化参考</text>
  <text class="page-foot">YI LIFE · 喜得测算</text>

  <!-- 人员信息弹层 -->
  <view class="editor-mask" wx:if="{{editingType}}" bindtap="closeEditor" catchtouchmove="noop">
    <view class="editor-sheet" catchtap="noop">
      <view class="editor-head">
        <view class="editor-titles">
          <text class="editor-eyebrow">{{editingType === 'mother' ? 'MOTHER' : 'PERSON'}}</text>
          <text class="editor-title">{{editingType === 'mother' ? '母亲信息' : '测算人信息'}}</text>
        </view>
        <text class="editor-close" hover-class="btn-hover" bindtap="closeEditor">✕</text>
      </view>

      <scroll-view class="editor-body" scroll-y>
        <view class="field">
          <view class="field-label"><text>属相</text></view>
          <view class="zodiac-grid">
            <view
              class="zodiac-chip {{draftZodiacIndex === index ? 'active' : ''}}"
              wx:for="{{zodiacs}}"
              wx:key="cn"
              hover-class="btn-hover"
              data-index="{{index}}"
              bindtap="onDraftZodiacSelect"
            >
              <text class="zc-yi">{{item.yi}}</text>
              <text class="zc-cn">{{item.cn}}</text>
            </view>
          </view>
        </view>

        <view class="field">
          <view class="field-label"><text>岁数</text><text class="field-sub">彝族虚岁 · 按今年可选</text></view>
          <view class="age-grid" wx:if="{{draftAges.length}}">
            <view
              class="age-chip {{draftAge === item ? 'active' : ''}}"
              wx:for="{{draftAges}}"
              wx:key="*this"
              hover-class="btn-hover"
              data-age="{{item}}"
              bindtap="onDraftAgeSelect"
            >
              <text class="age-num">{{item}}</text>
              <text class="age-unit">岁</text>
            </view>
          </view>
          <text class="field-hint" wx:else>请先选择属相，将按今年彝历列出可选岁数</text>
        </view>

        <view class="field" wx:if="{{editingType === 'person'}}">
          <view class="field-label"><text>性别</text><text class="field-sub">影响今年命宫推算</text></view>
          <view class="gender-grid">
            <view
              class="gender-chip {{draftGender === item.key ? 'active' : ''}}"
              wx:for="{{genders}}"
              wx:key="key"
              hover-class="btn-hover"
              data-key="{{item.key}}"
              bindtap="onDraftGenderSelect"
            >{{item.label}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="editor-actions">
        <button class="editor-btn ghost" hover-class="btn-hover" bindtap="closeEditor">取消</button>
        <button
          class="editor-btn primary {{draftCanSave ? '' : 'disabled'}}"
          hover-class="btn-hover"
          bindtap="confirmEditor"
        >确定</button>
      </view>
    </view>
  </view>

</layout>
