<!--pages/mine/mine.wxml-->
<layout needBack="{{false}}">

  <!-- 概览 -->
  <view class="summary">
    <view class="summary-glow"></view>
    <view class="summary-head">
      <view class="summary-title">让彝历贴近你的生活</view>
      <text class="summary-chip">本地存储</text>
    </view>
    <view class="summary-desc">所有设置仅保存在本机，保证隐私安全</view>
    <view class="current-card"  hover-class="btn-hover" bindtap="goMonth">
      <view class="current-yi">{{monthYi}}</view>
      <view class="current-info">
        <view class="current-label">{{monthLabel}}</view>
        <view class="current-value">可更具实际情况自定义设定</view>
      </view>
    </view>
  </view>

  <!-- 常用信息 -->
  <view class="member-card">
    <view class="member-head">
      <view class="member-head-text">
        <view class="member-title">常用信息</view>
      </view>
      <view class="member-manage" hover-class="btn-hover" bindtap="goMembers">
        <text>去管理</text>
        <text class="member-manage-arrow iconfont icon-you2"></text>
      </view>
    </view>
    <view class="member-grid">
      <view
        class="member-cell"
        wx:for="{{members}}"
        wx:key="id"
        hover-class="btn-hover"
        bindtap="goMembers"
      >
        <view class="member-avatar">{{item.icon}}</view>
      </view>
      <view class="member-cell" hover-class="btn-hover" bindtap="goMembers">
        <view class="member-avatar member-avatar-add">＋</view>
      </view>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="menu-card">
    <view class="menu-row" hover-class="btn-hover" bindtap="goAudio">
      <view class="menu-icon iconfont icon-shengyinkai"></view>
      <view class="menu-text">
        <view class="menu-title">音频设置</view>
        <view class="menu-desc">自动播放或手动播放</view>
      </view>
      <view class="menu-side">
        <text class="menu-arrow iconfont icon-you2"></text>
      </view>
    </view>

    <view class="menu-row" hover-class="btn-hover" bindtap="goMonth">
      <view class="menu-icon iconfont icon-yejing"></view>
      <view class="menu-text">
        <view class="menu-title">月份设置</view>
        <view class="menu-desc">自定义彝族年历起始月</view>
      </view>
      <view class="menu-side">
        <text class="menu-arrow iconfont icon-you2"></text>
      </view>
    </view>

    <button class="menu-row menu-row-btn" open-type="contact" hover-class="btn-hover">
      <view class="menu-icon iconfont icon-minzu-nv-fill"></view>
      <view class="menu-text">
        <view class="menu-title">联系客服</view>
        <view class="menu-desc">合作、问题反馈，联系微信客服</view>
      </view>
      <view class="menu-side">
        <text class="menu-arrow iconfont icon-you2"></text>
      </view>
    </button>
  </view>

  <text class="page-foot">数据仅保存在本机 · YI LIFE</text>

</layout>
