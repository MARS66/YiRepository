<!--pages/mine/mine.wxml-->
<layout title="我的" eyebrow="YI LIFE">
  <view class="profile-card">
    <view class="avatar">月</view>
    <view class="profile-info">
      <text class="profile-title">欢迎使用彝族生活日历</text>
      <text class="profile-desc">登录后同步收藏、提醒与家庭资料</text>
    </view>
    <button class="profile-btn">微信登录</button>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">家庭成员</text>
      <text class="section-link">管理 →</text>
    </view>
    <view class="family">
      <view class="family-item" wx:for="{{familyMembers}}" wx:key="label">
        <text class="family-icon">{{item.icon}}</text>
        <text class="family-label">{{item.label}}</text>
      </view>
      <view class="family-item">
        <text class="family-icon">＋</text>
        <text class="family-label">添加</text>
      </view>
    </view>
  </view>

  <view class="stats">
    <view class="stat-item" wx:for="{{stats}}" wx:key="label">
      <text class="stat-num">{{item.num}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" wx:for="{{menuItems}}" wx:key="label">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-label">{{item.label}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="member">
    <text class="member-label">文化助手会员</text>
    <text class="member-title">专注内容，告别打扰</text>
    <text class="member-desc">无广告 · 家庭档案 · 无限详细结果</text>
    <button class="member-btn">查看会员权益</button>
  </view>
</layout>