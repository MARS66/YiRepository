<!--pages/index/index.wxml-->
<page-meta background-color="{{isDark ? '#181713' : '#f8f4eb'}}" page-style="background-color: {{isDark ? '#181713' : '#f8f4eb'}};" />
<layout needBack="{{false}}" >
  <view class="hero">
    <!-- 彝文词云装饰背景 -->
    <view class="hero-cloud">
      <text wx:for="{{cloudWords}}" wx:key="item">{{item}}</text>
    </view>
    <view class="hero-glow"></view>

    <view class="hero-top">
      <text class="chip gold">今日彝历</text>
      <audio-btn id="page-audio" date="{{solarDate}}" color="gold" />
    </view>
    <view class="date-line">
      <text class="date-strong">{{date}}</text>
      <view class="date-meta">
        <text class="date-month">{{year}}</text>
        <text class="date-month">{{month}}月 <text class="date-weekday">星期{{weekday}}</text></text>
        
      </view>
      <view class="countdown" wx:if="{{festivalCountdown}}">
        <text class="countdown-label">{{festivalCountdown.label}}</text>
        <view class="countdown-num">
          <text class="countdown-days">{{festivalCountdown.isToday ? '今' : festivalCountdown.days}}</text>
          <text class="countdown-unit">天</text>
        </view>
      </view>
    </view>
    <text class="yi-text">{{yiDate.year[0]}}ꈎ·{{yiDate.month[0]}}ꆪ·{{yiDate.day[0]}}ꑍ·{{yiDate.dayMoon[0]}}ꑍ</text>
    <text class="muted light">{{yiDate.year[1]}}年·{{yiDate.month[1]}}月·{{yiDate.day[1]}}日·{{yiDate.dayMoon[1]}}日</text>
 
    <view class="solar">
      <text>{{year}}</text>
      <view class="solar-divider"></view>
      <text>{{monthEn}}</text>
    </view>   
    <view class="region-note" bindtap="goMonthSetting">
      <text class="region-mark">※</text>
      <text class="region-text">因区域差异彝历月份不尽相同，可在「我的」中调整</text>
    </view>
  </view>


  <daily-fortune fortune="{{todayFortune}}" />
</layout>