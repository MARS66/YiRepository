<!--pages/calendar/calendar.wxml-->
<layout needBack="{{false}}"  bind:themechange="onThemeChange">
  <view class="calendar-card">
    <calendar
      id="calendar"
      areas="{{calendarAreas}}"
      marks="{{marks}}"
      i-class="calendar"
      weekstart="{{1}}"
      alignDate="baseline"
      darkmode="{{isDark}}"
      style="{{calendarStyle}}"
      bindload="onCalendarLoad"
      bindclick="onCalendarClick"
      bindchange="onCalendarChange"
    />
  </view>
  <view class="calendar-detail">
    <view class="fortune-strip">
      <view class="fortune-label">
        <view>彝族</view>
        <view>日历</view>
      </view>
      <view class="fortune-body">
        <text class="fortune-main">{{yiDate.year[0]}}ꈎ·{{yiDate.month[0]}}ꆪ·{{yiDate.day[0]}}ꑍ·{{yiDate.dayMoon[0]}}ꑍ</text>
        <text class="fortune-desc">{{yiDate.year[1]}}年·{{yiDate.month[1]}}月·{{yiDate.day[1]}}日·{{yiDate.dayMoon[1]}}日</text>
      </view>
      <audio-btn date="{{solarDate}}"  />
    </view>
  </view>
  <view class="card selected-date">
    <view class="sec-head">
      <text class="section-title">彝历详情</text>
      <text class="section-link">术语说明</text>
    </view>
    <view class="term-grid">
      <view class="term-item">
        <view class="term-key">
          <text class="key-yi">ꈐꐡ</text>
          <text class="key-cn">库觉</text>
        </view>
        <view class="term-val">
          <text class="val-yi">{{kuJior[0]}}</text>
          <text class="val-cn">{{kuJior[1]}}</text>
        </view>
      </view>
      <view class="term-item">
        <view class="term-key">
          <text class="key-yi">ꆿꌋ</text>
          <text class="key-cn">狼色</text>
        </view>
        <view class="term-val">
          <text class="val-yi">{{laSe[0]}}</text>
          <text class="val-cn">{{laSe[1]}}</text>
        </view>
      </view>
      <view class="term-item">
        <view class="term-key">
          <text class="key-yi">ꃅꌋꋠꑍ</text>
          <text class="key-cn">木色则尼</text>
        </view>
        <view class="term-val">
          <text class="val-yi">{{zeta[0]}}</text>
          <text class="val-cn">{{zeta[1]}}</text>
        </view>
      </view>
      <view class="term-item">
        <view class="term-key">
          <text class="key-yi">ꄤꁨꌺ</text>
          <text class="key-cn">塔博惹</text>
        </view>
        <view class="term-val">
          <text class="val-yi">{{yiDate.tabooSon[0]}}</text>
          <text class="val-cn">{{yiDate.tabooSon[1]}}</text>
        </view>
      </view>
      <view class="term-item">
        <view class="term-key">
          <text class="key-yi">ꄤꁨꀋꃀ</text>
          <text class="key-cn">母塔博</text>
        </view>
        <view class="term-val">
          <text class="val-yi">{{yiDate.tabooMon[0]}}</text>
          <text class="val-cn">{{yiDate.tabooMon[1]}}</text>
        </view>
      </view>
      <view class="term-item">
        <view class="term-key">
          <text class="key-yi">ꄤꁨꀋꀮ</text>
          <text class="key-cn">公塔博</text>
        </view>
        <view class="term-val">
          <text class="val-yi">{{yiDate.tabooFat[0]}}</text>
          <text class="val-cn">{{yiDate.tabooFat[1]}}</text>
        </view>
      </view>
    </view>
    <view class="fortune-list">
      <view class="fortune-line warn">
        <text class="fl-badge">忌</text>
        <text class="fl-text">{{todayFortune.taboo[1]}}</text>
      </view>
      <view class="fortune-line info">
        <text class="fl-badge">行</text>
        <text class="fl-text">{{todayFortune.tabooFull}}</text>
      </view>
    </view>
 </view>
</layout>