<!--pages/calendar/calendar.wxml-->
<layout needBack="{{false}}"  bind:themechange="onThemeChange">
  <view class="calendar-card">
    <calendar
      id="calendar"
      areas="{{calendarAreas}}"
      marks="{{marks}}"
      i-class="calendar"
      weekstart="{{1}}"
      alignDate="baseline"
      darkmode="{{isDark}}"
      style="{{calendarStyle}}"
      bindload="onCalendarLoad"
      bindclick="onCalendarClick"
      bindchange="onCalendarChange"
    />
  </view>
  <view class="calendar-detail">
    <view class="fortune-strip">
      <view class="fortune-label">
        <view>彝族</view>
        <view>日历</view>
      </view>
      <view class="fortune-body">
        <text class="fortune-main">{{yiDate.year[0]}}ꈎ·{{yiDate.month[0]}}ꆪ·{{yiDate.day[0]}}ꑍ·{{yiDate.dayMoon[0]}}ꑍ</text>
        <text class="fortune-desc">{{yiDate.year[1]}}年·{{yiDate.month[1]}}月·{{yiDate.day[1]}}日·{{yiDate.dayMoon[1]}}日</text>
      </view>
      <audio-btn date="{{solarDate}}"  />
    </view>
  </view>
  <view class="card selected-date">
    <view class="sec-head">
      <text class="section-title">彝历详情</text>
      <text class="section-link">术语说明</text>
    </view>
    <view class="yi-grid">
      <view class="yi-item">
        <text class="yi-label">库觉</text>
        <text class="yi-val">{{kuJior}}</text>
      </view>
      <view class="yi-item">
        <text class="yi-label">狼色</text>
        <text class="yi-val">{{laSe}}</text>
      </view>
      <view class="yi-item">
        <text class="yi-label">木色则尼</text>
        <text class="yi-val">{{zeta}}</text>
      </view>
      <view class="yi-item">
        <text class="yi-label">塔博惹</text>
        <text class="yi-val">{{yiDate.tabooSon}}</text>
      </view>
      <view class="yi-item">
        <text class="yi-label">母塔博</text>
        <text class="yi-val">{{yiDate.tabooMon}}</text>
      </view>
      <view class="yi-item">
        <text class="yi-label">公塔博</text>
        <text class="yi-val">{{yiDate.tabooFat}}</text>
      </view>
    </view>
    <view class="yi-rows">
      <view class="yi-row">
        <text class="row-label">忌讳</text>
        <text class="row-val">{{todayFortune.taboo}}</text>
      </view>
      <view class="yi-row">
        <text class="row-label">出行</text>
        <text class="row-val">{{todayFortune.tabooFull}}</text>
      </view>
    </view>
 </view>
</layout>