{
  "pages": [
    "pages/index/index",
    "pages/assistant/assistant",
    "pages/calendar/calendar",
    "pages/mine/mine"
  ],
  "subPackages": [
    {
      "root": "subpages",
      "name": "subpages",
      "pages": [
        "suigong/suigong",
        "date-navigation/date-navigation",
        "shengchen/shengchen",
        "shengchen/result/result",
        "zeri/zeri",
        "zeri/result/result",
        "mine/audio/audio",
        "mine/month/month",
        "mine/members/members"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["subpages"]
    },
    "pages/mine/mine": {
      "network": "all",
      "packages": ["subpages"]
    }
  },
  "tabBar": {
    "backgroundColor": "#2b2923",
    "color": "#9e9588",
    "selectedColor": "#9c2d25",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "今日",
        "iconPath": "/static/index.png",
        "selectedIconPath": "/static/index_active.png"
      },
      {
        "pagePath": "pages/calendar/calendar",
        "text": "日历",
        "iconPath": "/static/calendar.png",
        "selectedIconPath": "/static/calendar_active.png"
      },
      {
        "pagePath": "pages/assistant/assistant",
        "text": "助手",
        "iconPath": "/static/assistant.png",
        "selectedIconPath": "/static/assistant_active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "/static/mine.png",
        "selectedIconPath": "/static/mine_active.png"
      }
    ]
  },
  "window": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#181713",
    "backgroundColorContent": "#00000000",
    "backgroundTextStyle": "light"
  },
  "style": "v2",
  "defaultLanguage": "zh_CN",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "tagNameStyleIsolation": "legacy",
      "disableABTest": true,
      "sdkVersionBegin": "3.0.0",
      "sdkVersionEnd": "15.255.255"
    }
  },
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "layout": "/components/layout/layout"
  }
}
